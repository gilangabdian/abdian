{
  "openapi": "3.1.0",
  "info": {
    "title": "Project API - Projects",
    "description": "API untuk mengelola projects (CRUD). Projects adalah portofolio karya yang menampilkan riwayat pekerjaan dan pencapaian.",
    "version": "1.1.0"
  },
  "paths": {
    "/api/projects": {
      "get": {
        "summary": "Get all projects",
        "tags": ["Projects"],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Project" }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new project",
        "tags": ["Projects"],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["title", "description", "start_date", "status", "thumbnail"],
                "properties": {
                  "title": { "type": "string", "description": "Project title" },
                  "description": { "type": "string", "description": "Project description" },
                  "is_featured": { "type": "boolean", "description": "Whether the project is featured" },
                  "start_date": { "type": "string", "format": "date", "description": "Start date" },
                  "end_date": { "type": "string", "format": "date", "description": "End date (nullable)" },
                  "status": { "type": "string", "enum": ["completed", "in_development", "on_hold", "cancelled"] },
                  "type": { "type": "string", "enum": ["web_development", "mobile_development", "desktop_application", "game_development"] },
                  "thumbnail": { "type": "string", "format": "binary", "description": "Project thumbnail (image or video file)" },
                  "youtube_url": { "type": "string", "format": "uri", "description": "YouTube video URL" },
                  "twitter_url": { "type": "string", "format": "uri", "description": "Twitter/X post URL" },
                  "live_demo_link": { "type": "string", "format": "uri" },
                  "repository_link": { "type": "string", "format": "uri" },
                  "tech_stack_ids": { "type": "array", "items": { "type": "integer" }, "description": "Array of skill IDs" },
                  "custom_tech_stacks": { "type": "array", "items": { "type": "object", "properties": { "name": { "type": "string" }, "icon_url": { "type": "string" } } } },
                  "team_size": { "type": "integer", "minimum": 1 },
                  "role": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Project created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "data": { "$ref": "#/components/schemas/Project" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/projects/reorder": {
      "put": {
        "summary": "Reorder projects (drag-and-drop order)",
        "tags": ["Projects"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["ordered_ids"],
                "properties": {
                  "ordered_ids": {
                    "type": "array",
                    "items": { "type": "integer" },
                    "description": "Array of project IDs in their new desired order"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Projects reordered successfully"
          }
        }
      }
    },
    "/api/projects/{id}": {
      "get": {
        "summary": "Get a single project",
        "tags": ["Projects"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Project" }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Update a project",
        "tags": ["Projects"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": { "type": "string" },
                  "description": { "type": "string" },
                  "is_featured": { "type": "boolean" },
                  "start_date": { "type": "string", "format": "date" },
                  "end_date": { "type": ["string", "null"], "format": "date" },
                  "status": { "type": "string", "enum": ["completed", "in_development", "on_hold", "cancelled"] },
                  "type": { "type": ["string", "null"], "enum": ["web_development", "mobile_development", "desktop_application", "game_development"] },
                  "thumbnail": { "type": "string", "format": "binary", "description": "New thumbnail file to upload (replaces existing)" },
                  "remove_thumbnail": { "type": "boolean", "description": "Set to true to remove the existing thumbnail without uploading a new one" },
                  "youtube_url": { "type": "string", "format": "uri" },
                  "twitter_url": { "type": "string", "format": "uri" },
                  "live_demo_link": { "type": "string", "format": "uri" },
                  "repository_link": { "type": "string", "format": "uri" },
                  "tech_stack_ids": { "type": "array", "items": { "type": "integer" } },
                  "custom_tech_stacks": { "type": "array", "items": { "type": "object", "properties": { "name": { "type": "string" }, "icon_url": { "type": "string" } } } },
                  "team_size": { "type": "integer", "minimum": 1 },
                  "role": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Project updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "data": { "$ref": "#/components/schemas/Project" }
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete a project",
        "tags": ["Projects"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Project deleted successfully"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Project": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "is_featured": { "type": "boolean" },
          "start_date": { "type": "string", "format": "date" },
          "end_date": { "type": ["string", "null"], "format": "date" },
          "status": { "type": "string" },
          "type": { "type": ["string", "null"] },
          "thumbnail_path": { "type": ["string", "null"] },
          "thumbnail_url": { "type": ["string", "null"], "format": "uri" },
          "media_type": { "type": ["string", "null"], "enum": ["image", "video"] },
          "youtube_url": { "type": ["string", "null"] },
          "twitter_url": { "type": ["string", "null"] },
          "live_demo_link": { "type": ["string", "null"] },
          "repository_link": { "type": ["string", "null"] },
          "team_size": { "type": ["integer", "null"] },
          "role": { "type": ["string", "null"] },
          "custom_tech_stacks": { "type": ["array", "null"] },
          "sort_order": { "type": "integer" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" },
          "skills": { "type": "array", "items": { "$ref": "#/components/schemas/Skill" } }
        }
      },
      "Skill": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "icon_url": { "type": "string" },
          "proficiency": { "type": "integer" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" },
          "pivot": { "type": "object", "properties": { "project_id": { "type": "integer" }, "skill_id": { "type": "integer" } } }
        }
      }
    }
  }
}