{
    "openapi": "3.0.3",
    "info": {
        "title": "About Page API",
        "description": "API untuk mengelola konten halaman About (/about). Konten disimpan di database sebagai HTML (dari Tiptap editor), memungkinkan admin mengedit halaman About tanpa mengubah kode.\n\nStruktur: Singleton — hanya ada 1 row dalam tabel `about_pages`.\n\nCatatan: Saat content bernilai null, frontend akan menampilkan konten hardcoded lama (fallback).",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000"
        }
    ],
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        },
        "schemas": {
            "AboutPage": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "content": {
                        "type": "string",
                        "nullable": true,
                        "description": "Konten HTML dari Tiptap editor. Bisa null jika belum diisi admin.",
                        "example": "<h2>About Me</h2><p>Hello, I am Abdian...</p>"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2026-07-27T00:00:00.000000Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2026-07-27T10:00:00.000000Z"
                    }
                }
            }
        }
    },
    "paths": {
        "/api/about-page": {
            "get": {
                "summary": "Get About Page Content (🌍 Global/Public)",
                "description": "Mengembalikan konten halaman About. Jika content bernilai null (belum diatur admin), frontend akan melakukan fallback ke konten hardcoded.\n\nResponse: `{ data: AboutPage | null, message: string }`",
                "responses": {
                    "200": {
                        "description": "Success - About page content",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/AboutPage"
                                        },
                                        "message": {
                                            "type": "string",
                                            "description": "Pesan tambahan (misal: 'About page has not been set up yet.')",
                                            "nullable": true
                                        }
                                    }
                                },
                                "example": {
                                    "data": {
                                        "id": 1,
                                        "content": "<h2>About Me</h2><p>I am a fullstack developer...</p>",
                                        "created_at": "2026-07-27T00:00:00.000000Z",
                                        "updated_at": "2026-07-27T10:00:00.000000Z"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/admin/about-page": {
            "put": {
                "summary": "Update About Page Content (🔒 Admin Only)",
                "description": "Menyimpan atau memperbarui konten halaman About. Endpoint ini bersifat upsert — jika belum ada data, akan dibuat; jika sudah ada, akan diupdate.\n\nContent berisi HTML yang dihasilkan oleh Tiptap editor (termasuk callout block, code blocks, dll).",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["content"],
                                "properties": {
                                    "content": {
                                        "type": "string",
                                        "nullable": true,
                                        "description": "Konten HTML untuk halaman About. Bisa dikosongkan (null atau empty string).",
                                        "example": "<h2>About Me</h2><p>I am a fullstack developer with 5 years of experience...</p><blockquote class=\"callout\">Note: This is a callout</blockquote>"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "About page updated successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "About page updated successfully."
                                        },
                                        "data": {
                                            "$ref": "#/components/schemas/AboutPage"
                                        }
                                    }
                                },
                                "example": {
                                    "message": "About page updated successfully.",
                                    "data": {
                                        "id": 1,
                                        "content": "<h2>About Me</h2><p>Updated content...</p>",
                                        "created_at": "2026-07-27T00:00:00.000000Z",
                                        "updated_at": "2026-07-27T11:00:00.000000Z"
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated - No valid Bearer token"
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "example": {
                                    "message": "The given data was invalid.",
                                    "errors": {
                                        "content": [
                                            "The content field must be a string."
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}