{
  "openapi": "3.0.0",
  "info": {
    "title": "Sitemap API",
    "description": "API Endpoint for generating dynamic sitemap.xml",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://qbdian-api.onrender.com/api"
    }
  ],
  "paths": {
    "/sitemap": {
      "get": {
        "summary": "Get dynamic sitemap.xml",
        "description": "Returns a dynamically generated XML sitemap containing active static routes (with /about, /certificates, and /projects + /projects/day-one dynamically included based on Profile visibility flags) and published blogs. Excludes dead routes (/projects/{id}, /contacts) and draft blogs.",
        "tags": ["Sitemap"],
        "responses": {
          "200": {
            "description": "Successful operation, returns XML sitemap",
            "content": {
              "text/xml": {
                "schema": {
                  "type": "string",
                  "example": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n  <url>\n    <loc>https://abdian.my.id/</loc>\n    <changefreq>weekly</changefreq>\n    <priority>1.0</priority>\n  </url>\n  <url>\n    <loc>https://abdian.my.id/projects</loc>\n    <changefreq>weekly</changefreq>\n    <priority>0.9</priority>\n  </url>\n  <url>\n    <loc>https://abdian.my.id/projects/day-one</loc>\n    <changefreq>weekly</changefreq>\n    <priority>0.7</priority>\n  </url>\n  <url>\n    <loc>https://abdian.my.id/blogs</loc>\n    <changefreq>weekly</changefreq>\n    <priority>0.9</priority>\n  </url>\n  <url>\n    <loc>https://abdian.my.id/blogs/my-first-blog</loc>\n    <changefreq>monthly</changefreq>\n    <priority>0.8</priority>\n  </url>\n</urlset>"
                }
              }
            }
          }
        }
      }
    },
    "/prerender-routes": {
      "get": {
        "summary": "Get all active frontend routes for prerendering",
        "description": "Returns a JSON array of all active public routes (core static routes, conditionally /about, /certificates, and /projects + /projects/day-one based on Profile visibility flags, plus published blog slugs).",
        "tags": ["Sitemap"],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "example": [
                  "/",
                  "/projects",
                  "/projects/day-one",
                  "/blogs",
                  "/artworks",
                  "/photos",
                  "/blogs/my-first-blog"
                ]
              }
            }
          }
        }
      }
    }
  }
}
