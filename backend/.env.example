APP_NAME="Gilang Abdian Portfolio API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database: Local (SQLite/MySQL) or Production Neon PostgreSQL via DB_URL
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=my_portofolio_new_db
# DB_USERNAME=root
# DB_PASSWORD=
# DB_URL="postgresql://user:password@host/dbname?sslmode=require"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database

# Storage Disk: 'public' for local dev, 'cloudinary' for production
FILESYSTEM_DISK=public

# Cloudinary Configuration (required when FILESYSTEM_DISK=cloudinary)
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_NOTIFICATION_URL=
CLOUDINARY_SECURE_URL=true

# Frontend & CORS Configuration (Unified Single Source of Truth)
# Local: http://localhost:3000 | Production: https://abdian.my.id
FRONTEND_URL=http://localhost:3000
# Optional: comma-separated origins for CORS if multiple needed
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://abdian.my.id

# Next.js On-Demand ISR Revalidation (Secret token shared with Next.js)
# Note: Target revalidation URL automatically uses FRONTEND_URL.
# NEXTJS_BASE_URL is optional, use only as an override if revalidation host differs from FRONTEND_URL.
# NEXTJS_BASE_URL=http://localhost:3000
NEXTJS_REVALIDATION_SECRET=

# Vercel Deploy Hook (Optional)
VERCEL_WEBHOOK_URL=

# Default Admin Credentials for Database Seeding
ADMIN_EMAIL=admin@example.com
ADMIN_PASS=password
